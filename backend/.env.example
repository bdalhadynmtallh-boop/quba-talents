# Encode special characters in the database password when used in this URL.
DATABASE_URL=postgresql://quba:CHANGE_ME@127.0.0.1:5432/quba_talents
COOKIE_SECRET=
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5186
SESSION_HOURS=8
# Set an absolute persistent disk path in production.
STORAGE_DIR=.data/uploads
# Free cloud deployment uses a PRIVATE Supabase bucket. These are server-only.
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=quba-private
# Text model only. Set the actual regional/workspace URL from the provider console.
AI_API_KEY=
AI_BASE_URL=https://api.xkiro.com/v1
AI_MODEL=qwen/qwen3.8-omni-flash:free
AI_TIMEOUT_MS=60000
AI_OUTPUT_MODE=json_object
# Optional absolute path; otherwise uses Playwright installed Chromium.
CHROMIUM_EXECUTABLE_PATH=
