{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && npm run build -w @quba/shared && npm run build -w @quba/web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://quba-talents-api.onrender.com/api/:path*" },
    {
      "source": "/health/:path*",
      "destination": "https://quba-talents-api.onrender.com/health/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
