generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Grade {
  FIRST
  SECOND
  THIRD
}
enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}
enum AcademicYearStatus {
  OPEN
  CLOSED
}
enum StudentStatus {
  ACTIVE
  ARCHIVED
}
model Admin {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  name String @db.VarChar(100)
  passwordHash String
  sessions Session[]
  reviewedRequests RegistrationRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @db.Char(64)
  adminId String @db.Uuid
  admin Admin @relation(fields:[adminId], references:[id], onDelete:Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([adminId])
  @@index([expiresAt])
}
model Student {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  grade Grade
  nameSearch String
  classroomId String @db.Uuid
  classroom Classroom @relation(fields:[classroomId], references:[id], onDelete:Restrict)
  primaryTalentId String @db.Uuid
  primaryTalent Talent @relation(fields:[primaryTalentId], references:[id], onDelete:Restrict)
  additionalTalents StudentTalent[]
  academicYearId String @db.Uuid
  academicYear AcademicYear @relation(fields:[academicYearId], references:[id], onDelete:Restrict)
  status StudentStatus @default(ACTIVE)
  archivedAt DateTime?
  skills String[] @default([])
  achievements Json @default("[]")
  supervisorOverrides Json?
  notes String @default("")
  isPublic Boolean @default(false)
  cv StudentCv?
  works Work[]
  registration RegistrationRequest?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([academicYearId, status, grade])
  @@index([primaryTalentId])
  @@index([classroomId])
  @@index([nameSearch])
}
model RegistrationRequest {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  grade Grade
  nameSearch String
  classroomId String @db.Uuid
  classroom Classroom @relation(fields:[classroomId], references:[id], onDelete:Restrict)
  primaryTalentId String @db.Uuid
  primaryTalent Talent @relation(fields:[primaryTalentId], references:[id], onDelete:Restrict)
  additionalTalents RegistrationTalent[]
  description String @db.VarChar(1000)
  status RegistrationStatus @default(PENDING)
  reviewedAt DateTime?
  reviewedById String? @db.Uuid
  reviewedBy Admin? @relation(fields:[reviewedById], references:[id], onDelete:SetNull)
  studentId String? @unique @db.Uuid
  student Student? @relation(fields:[studentId], references:[id], onDelete:SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([nameSearch])
  @@index([classroomId])
  @@index([primaryTalentId])
}
model StudentCv {
  id String @id @default(uuid()) @db.Uuid
  studentId String @unique @db.Uuid
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  content String @default("")
  draft Json?
  approved Json?
  draftUpdatedAt DateTime?
  approvedAt DateTime?
  generatedAt DateTime?
  revision Int @default(0)
  draftSnapshot Json?
  approvedSnapshot Json?
  draftSourceHash String?
  approvedSourceHash String?
  generationToken String? @db.Uuid
  generationExpiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Work {
  id String @id @default(uuid()) @db.Uuid
  studentId String @db.Uuid
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  title String @db.VarChar(150)
  description String @default("")
  date DateTime?
  url String? @db.VarChar(2048)
  studentRole String @default("")
  attachments Attachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studentId, createdAt])
}
model Attachment {
  id String @id @default(uuid()) @db.Uuid
  workId String @db.Uuid
  work Work @relation(fields:[workId], references:[id], onDelete:Cascade)
  storageKey String @unique
  originalName String @db.VarChar(255)
  mimeType String @db.VarChar(100)
  sizeBytes Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workId])
}
model SchoolSettings {
  id String @id @default("school")
  name String @default("موهوبين ثانوية قباء")
  logoKey String? @unique
  logoName String?
  logoMimeType String?
  supervisors Supervisor[]
  classrooms Classroom[]
  talents Talent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Supervisor {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @default("school")
  school SchoolSettings @relation(fields:[schoolId], references:[id], onDelete:Cascade)
  name String @db.VarChar(100)
  role String @db.VarChar(120)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([schoolId, sortOrder])
}
model StorageDeletion {
  id String @id @default(uuid()) @db.Uuid
  storageKey String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model AcademicYear {
  id String @id @default(uuid()) @db.Uuid
  label String @db.VarChar(40)
  status AcademicYearStatus @default(OPEN)
  openedAt DateTime @default(now())
  closedAt DateTime?
  rolloverRequestId String? @unique @db.Uuid
  rolloverResult Json?
  students Student[]
}
model Classroom {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @default("school")
  school SchoolSettings @relation(fields:[schoolId], references:[id], onDelete:Restrict)
  name String @db.VarChar(30)
  nameKey String
  sortOrder Int @default(0)
  active Boolean @default(true)
  students Student[]
  requests RegistrationRequest[]
  @@unique([schoolId, nameKey])
  @@index([schoolId, active, sortOrder])
}
model Talent {
  id String @id @default(uuid()) @db.Uuid
  schoolId String @default("school")
  school SchoolSettings @relation(fields:[schoolId], references:[id], onDelete:Restrict)
  name String @db.VarChar(80)
  nameKey String
  sortOrder Int @default(0)
  active Boolean @default(true)
  students Student[]
  requests RegistrationRequest[]
  additionalStudents StudentTalent[]
  additionalRequests RegistrationTalent[]
  @@unique([schoolId, nameKey])
  @@index([schoolId, active, sortOrder])
}
model StudentTalent {
  sortOrder Int @default(0)
  studentId String @db.Uuid
  talentId String @db.Uuid
  student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)
  talent Talent @relation(fields:[talentId], references:[id], onDelete:Restrict)
  @@id([studentId, talentId])
  @@index([talentId])
}
model RegistrationTalent {
  sortOrder Int @default(0)
  registrationId String @db.Uuid
  talentId String @db.Uuid
  registration RegistrationRequest @relation(fields:[registrationId], references:[id], onDelete:Cascade)
  talent Talent @relation(fields:[talentId], references:[id], onDelete:Restrict)
  @@id([registrationId, talentId])
  @@index([talentId])
}
