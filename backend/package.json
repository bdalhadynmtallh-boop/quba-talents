{
  "name": "@quba/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/index.ts",
    "admin:setup": "tsx src/modules/auth/setup-admin.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@quba/shared": "*",
    "@supabase/supabase-js": "2.117.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "file-type": "^21.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.16.3",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "prisma": "7.10.0",
    "tsx": "^4.21.0"
  }
}
